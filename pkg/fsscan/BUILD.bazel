load("@io_bazel_rules_go//go:def.bzl", "go_library", "go_test")

# srcs stays a flat list: rules_go applies the Go build constraints on platform_unix.go and
# platform_unsupported.go itself when compiling. deps is the part that has to be conditional, so
# that a Windows build does not require golang.org/x/sys. Both forms are gazelle's own output.
go_library(
    name = "fsscan",
    srcs = [
        "openbeneath.go",
        "platform_unix.go",
        "platform_unsupported.go",
        "scan.go",
        "users.go",
    ],
    importpath = "github.com/macadmins/osquery-extension/pkg/fsscan",
    visibility = ["//visibility:public"],
    deps = [
        "//pkg/utils",
    ] + select({
        "@io_bazel_rules_go//go/platform:aix": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:android": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:darwin": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:dragonfly": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:freebsd": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:illumos": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:ios": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:linux": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:netbsd": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:openbsd": [
            "@org_golang_x_sys//unix",
        ],
        "@io_bazel_rules_go//go/platform:solaris": [
            "@org_golang_x_sys//unix",
        ],
        "//conditions:default": [],
    }),
)

go_test(
    name = "fsscan_test",
    srcs = [
        "components_test.go",
        "dedup_test.go",
        "openbeneath_test.go",
        "readcandidate_test.go",
        "scan_test.go",
        "scan_unix_test.go",
        "timeout_test.go",
        "users_test.go",
    ],
    embed = [":fsscan"],
)
